<?xml version = '1.0' encoding = 'UTF-8'?>
<!--
  Identity showcase (#17): a customer list (Oracle Forms) above the Vaadin notes
  view, which adds notes as the Forms user. This XML is the source of truth;
  deploy-form.sh turns it into hybrid_notes.fmb with frmxml2f and compiles it.

  The [hybrid-notes] config section has no userid, so Forms shows its logon
  dialog: log in as alice/alice or bob/bob (database HYBRIDDB, the default).

  The view asks for its user with the TOKEN_NEEDED event. The form answers with
  a one-time token from hybrid.issue_token, which the database ties to the user
  this session logged in as. The user name itself never goes through the bean:
  the bean runs on the user's machine, so the view couldn't trust it.
-->
<Module version="122010400" xmlns="http://xmlns.oracle.com/Forms">
   <FormModule Name="HYBRID_NOTES" Title="Forms and Vaadin: who is the user?" ConsoleWindow="MAIN">
      <Coordinate CharacterCellWidth="5" RealUnit="Point" DefaultFontScaling="true" CharacterCellHeight="14" CoordinateSystem="Real"/>
      <Block Name="CUSTOMERS" QueryDataSourceName="CUSTOMERS" OrderByClause="NAME" RecordsDisplayCount="6" InsertAllowed="false" UpdateAllowed="false" DeleteAllowed="false" RecordVisualAttributeGroupName="CURRENT_RECORD" ShowScrollbar="true" ScrollbarCanvasName="MAIN" ScrollbarXPosition="512" ScrollbarYPosition="40" ScrollbarWidth="12" ScrollbarLength="84">
         <Item Name="ID" ItemType="Text Item" DataType="Number" MaximumLength="6" ColumnName="ID" CanvasName="MAIN" XPosition="16" YPosition="40" Width="44" Height="14" BackColor="white" Prompt="Id" PromptAttachmentEdge="Top" PromptAlign="Center" PromptDisplayStyle="First Record"/>
         <Item Name="NAME" ItemType="Text Item" DataType="Char" MaximumLength="60" ColumnName="NAME" CanvasName="MAIN" XPosition="60" YPosition="40" Width="200" Height="14" BackColor="white" Prompt="Customer" PromptAttachmentEdge="Top" PromptAlign="Center" PromptDisplayStyle="First Record"/>
         <Item Name="CITY" ItemType="Text Item" DataType="Char" MaximumLength="40" ColumnName="CITY" CanvasName="MAIN" XPosition="260" YPosition="40" Width="130" Height="14" BackColor="white" Prompt="City" PromptAttachmentEdge="Top" PromptAlign="Center" PromptDisplayStyle="First Record"/>
         <Item Name="COUNTRY" ItemType="Text Item" DataType="Char" MaximumLength="40" ColumnName="COUNTRY" CanvasName="MAIN" XPosition="390" YPosition="40" Width="122" Height="14" BackColor="white" Prompt="Country" PromptAttachmentEdge="Top" PromptAlign="Center" PromptDisplayStyle="First Record"/>
         <Trigger Name="WHEN-NEW-RECORD-INSTANCE" TriggerText="-- Not for the empty record after the last row.&amp;#10;IF :customers.id IS NOT NULL THEN&amp;#10;  SET_CUSTOM_PROPERTY('CONTROL.VAADIN_VIEW', 1, 'CUSTOMER', :customers.id || '|' || :customers.name);&amp;#10;END IF;"/>
         <DataSourceColumn DSCName="ID" DSCType="NUMBER" DSCLength="0" DSCPrecision="6" DSCScale="0" DSCMandatory="true" DSCNochildren="false" Type="Query"/>
         <DataSourceColumn DSCName="NAME" DSCType="VARCHAR2" DSCLength="60" DSCPrecision="0" DSCScale="0" DSCMandatory="true" DSCNochildren="false" Type="Query"/>
         <DataSourceColumn DSCName="CITY" DSCType="VARCHAR2" DSCLength="40" DSCPrecision="0" DSCScale="0" DSCMandatory="false" DSCNochildren="false" Type="Query"/>
         <DataSourceColumn DSCName="COUNTRY" DSCType="VARCHAR2" DSCLength="40" DSCPrecision="0" DSCScale="0" DSCMandatory="false" DSCNochildren="false" Type="Query"/>
      </Block>
      <Block Name="CONTROL" DatabaseBlock="false">
         <Item Name="FORMS_USER" ItemType="Display Item" DataType="Char" MaximumLength="128" CanvasName="MAIN" XPosition="430" YPosition="8" Width="94" Height="14" Prompt="Forms user:" PromptAttachmentEdge="Start" PromptAttachmentOffset="4"/>
         <Item Name="VAADIN_VIEW" ItemType="Bean Area" ImplementationClass="org.vaadin.formshybrid.bean.VaadinBean" CanvasName="MAIN" XPosition="16" YPosition="150" Width="520" Height="270" KeyboardNavigable="false" MouseNavigate="false">
            <Trigger Name="WHEN-CUSTOM-ITEM-EVENT" TriggerText="IF :SYSTEM.CUSTOM_ITEM_EVENT = 'TOKEN_NEEDED' THEN&amp;#10;  -- A one-time token that the database ties to the user this session&amp;#10;  -- logged in as. Never send the user name itself: the view can't trust it.&amp;#10;  SET_CUSTOM_PROPERTY('CONTROL.VAADIN_VIEW', 1, 'TOKEN', hybrid.issue_token);&amp;#10;END IF;"/>
         </Item>
      </Block>
      <Canvas Name="MAIN" WindowName="MAIN" Width="552" Height="430" ViewportWidth="552" ViewportHeight="430">
         <Graphics Name="LIST_TITLE" GraphicsType="Text" XPosition="16" YPosition="8" Width="300" Height="16" FillPattern="transparent" EdgePattern="none" HorizontalJustification="Start">
            <CompoundText Name="LIST_TITLE_TXT">
               <TextSegment Name="LIST_TITLE_SEG" FontName="Dialog" FontSize="1000" FontStyle="Plain" FontWeight="Bold" ForegroundColor="black" Text="Customers (Oracle Forms)"/>
            </CompoundText>
         </Graphics>
         <Graphics Name="VIEW_TITLE" GraphicsType="Text" XPosition="16" YPosition="132" Width="400" Height="16" FillPattern="transparent" EdgePattern="none" HorizontalJustification="Start">
            <CompoundText Name="VIEW_TITLE_TXT">
               <TextSegment Name="VIEW_TITLE_SEG" FontName="Dialog" FontSize="1000" FontStyle="Plain" FontWeight="Bold" ForegroundColor="black" Text="Embedded Vaadin view: notes, written as the Forms user"/>
            </CompoundText>
         </Graphics>
      </Canvas>
      <Trigger Name="WHEN-NEW-FORM-INSTANCE" TriggerText="SET_WINDOW_PROPERTY(FORMS_MDI_WINDOW, TITLE, 'Forms and Vaadin: who is the user?');&amp;#10;SET_CUSTOM_PROPERTY('CONTROL.VAADIN_VIEW', 1, 'ROUTE', 'notes');&amp;#10;-- Only shown in Forms; the view learns the user from a token.&amp;#10;:control.forms_user := UPPER(GET_APPLICATION_PROPERTY(USERNAME));&amp;#10;GO_BLOCK('CUSTOMERS');&amp;#10;EXECUTE_QUERY;"/>
      <VisualAttribute Name="CURRENT_RECORD" BackColor="r25g25b50" ForegroundColor="white"/>
      <Window Name="MAIN" Title="Customers" Width="552" Height="430"/>
   </FormModule>
</Module>
